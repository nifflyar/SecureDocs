{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "demo": {
      "type": "boolean"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "senderOrganizationId": {
      "type": "string",
      "minLength": 1
    },
    "recipientOrganizationId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "academic_mobility"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "transcript",
              "learning_agreement",
              "diploma",
              "certificate"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provenance": {
            "enum": [
              "student_copy",
              "issuer_confirmed",
              "manual_confirmed"
            ]
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "enum": [
                  "not_checked",
                  "confirmed",
                  "mismatch",
                  "not_found",
                  "unavailable",
                  "manual_review"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "checkedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "outcome",
              "method",
              "sourceRef",
              "checkedAt",
              "limitations"
            ]
          }
        },
        "required": [
          "documentId",
          "version",
          "type",
          "sha256",
          "provenance",
          "verification"
        ]
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approved",
              "returned"
            ]
          }
        },
        "required": [
          "documentId",
          "version",
          "role",
          "decision"
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "revoked",
            "expired"
          ]
        }
      },
      "required": [
        "expiresAt",
        "status"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "demo",
    "packageId",
    "senderOrganizationId",
    "recipientOrganizationId",
    "purpose",
    "documents",
    "approvals",
    "access"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecureDocs package manifest 1.0 (design contract)"
}